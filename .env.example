NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-or-production-publishable-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Generate 32 random bytes and base64-encode them; keep this stable and private.
WALLET_BANK_DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key

# HMAC secret for short-lived withdrawal verification codes (server-only; 32+ random chars).
WALLET_WITHDRAWAL_CODE_PEPPER=replace-with-a-long-random-secret
